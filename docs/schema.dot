digraph EVCC_SIFT_Schema {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc="t",
         label="How EVCC-SIFT-Mutator works", bgcolor="white",
         nodesep=0.55, ranksep=0.85, pad=0.4, dpi=150];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
         penwidth=1.5, margin="0.3,0.2", color="#8a94a6", fillcolor="#ffffff"];
  edge  [fontname="Helvetica", fontsize=11, color="#9aa5b1", arrowsize=0.9, penwidth=1.4];

  CLI    [label="Start a test run", fillcolor="#e8eefc", color="#5b7cc4"];
  LOOP   [label="AI mutation loop\npick strategy - mutate - self-heal - rank", fillcolor="#efeafb", color="#8a7fc0"];
  TARGET [label="Charging station\nmock or real", fillcolor="#fde5c7", color="#d08a3a"];
  REPORT [label="Report\nwhat happened", fillcolor="#d9ecdc", color="#5aa06e"];

  CLI -> LOOP;
  LOOP -> TARGET [label="send test"];
  TARGET -> LOOP [label="learn from response", style=dashed, color="#c08a2e", fontcolor="#a9791f", constraint=false];
  TARGET -> REPORT [color="#5aa06e", fontcolor="#3f7a54"];
}
